{
  "name": "@gym/logging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Logging service: AWS Lambda + DynamoDB + EventBridge. Records sets, reps and push-up counts; publishes workout.logged.v1.",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node --env-file=.env --import ../../infra/logging/node_modules/tsx/dist/loader.mjs scripts/setup.ts",
    "gen:openapi": "node --import ../../infra/logging/node_modules/tsx/dist/loader.mjs scripts/genOpenapi.ts",
    "deploy:bootstrap": "cd ../../infra/logging && node --env-file=../../services/logging/.env ./node_modules/aws-cdk/bin/cdk bootstrap",
    "deploy:diff": "cd ../../infra/logging && node --env-file=../../services/logging/.env ./node_modules/aws-cdk/bin/cdk diff",
    "deploy": "cd ../../infra/logging && node --env-file=../../services/logging/.env ./node_modules/aws-cdk/bin/cdk deploy --require-approval never"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@gym/contracts": "workspace:*",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@readme/openapi-parser": "^2.6.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
