{
  "name": "@gym/progress",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Progress service: AWS Lambda + DynamoDB. XP, levels, Duolingo-style streaks, daily push-up targets. Consumes workout.logged.v1 from EventBridge.",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@gym/contracts": "workspace:*",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
