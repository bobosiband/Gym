# Local developer environment for @gym/auth. Copy to services/auth/.env
# and fill in. Never commit services/auth/.env; it is gitignored.
#
# The AWS keys below are only read by the local setup script and the
# CDK commands run from your machine. They are never copied into SSM,
# Lambda environment variables, logs, or any other committed file.
# Deployed Lambdas get their AWS access from their IAM roles only.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Gmail SMTP. Create an App Password at
# https://myaccount.google.com/apppasswords. The 16 character password
# below never leaves SSM once the setup script has stored it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated allow list of frontend origins, or * to allow all.
# Example: APP_ORIGINS=https://gym.example,http://localhost:5173
# Example (open while bringing up the frontend): APP_ORIGINS=*
APP_ORIGINS=
