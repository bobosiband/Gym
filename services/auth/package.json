{
  "name": "@gym/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auth service: AWS Lambda + DynamoDB + EventBridge. Sign-up, login, token issuance, JWKS.",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node --env-file=.env --import ../../infra/auth/node_modules/tsx/dist/loader.mjs scripts/setup.ts",
    "deploy:bootstrap": "cd ../../infra/auth && node --env-file=../../services/auth/.env ./node_modules/aws-cdk/bin/cdk bootstrap",
    "deploy:diff": "cd ../../infra/auth && node --env-file=../../services/auth/.env ./node_modules/aws-cdk/bin/cdk diff",
    "deploy": "cd ../../infra/auth && node --env-file=../../services/auth/.env ./node_modules/aws-cdk/bin/cdk deploy --require-approval never"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@gym/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
