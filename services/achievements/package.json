{
  "name": "@gym/achievements",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Achievements service: Cloudflare Worker over D1. Consumes workout.logged.v1 and progress.level_up.v1 via a signed internal webhook; emits achievement.unlocked.v1.",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create:remote": "wrangler d1 create gym-achievements",
    "db:migrate:local": "wrangler d1 migrations apply gym-achievements --local",
    "db:migrate:remote": "wrangler d1 migrations apply gym-achievements --remote"
  },
  "dependencies": {
    "@gym/contracts": "workspace:*",
    "@gym/exercise-core": "workspace:*",
    "@gym/exercise-pushup": "workspace:*",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250710.0",
    "@types/node": "^20.19.0",
    "wrangler": "^3.90.0"
  }
}
