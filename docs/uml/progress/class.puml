@startuml
title Gym progress: core classes (Stage 3)

skinparam shadowing false

package "services/progress/src" {
  package "handlers" {
    class HealthHandler <<utility>>
    class GetProgressHandler
    class SetTimeZoneHandler
    class SetDailyTargetHandler
    class WorkoutLoggedConsumer
    class HandlerBase <<utility>>
  }

  package "progress" {
    class ProgressService {
      + getProgress(userId): Promise<ProgressState>
      + setTimeZone(userId, zone): Promise<ProgressState>
      + setDailyTarget(userId, request): Promise<ProgressState>
      + grantFreezes(userId, amount): Promise<ProgressState>
      + handleWorkoutLogged(event): Promise<void>
    }
    class ProgressServiceError
    interface ProgressRepository
    interface ProcessedEventRepository
    class DynamoProgressRepository
    class DynamoProcessedEventRepository
    class XpRules <<utility>>
    class StreakRules <<utility>>
    class FreezeRules <<utility>>
  }

  package "events" {
    interface EventPublisher
    class EventBridgeEventPublisher
  }

  package "tokens" {
    interface JwtVerifier
    class JwksJwtVerifier
  }

  package "config" {
    interface ProgressConfig
    class SsmConfigLoader {
      - paramPrefix: string (trailing slash normalised)
      + load(): Promise<ProgressConfig>
    }
  }

  package "http" {
    class ApiResponder <<utility>>
    class ApiErrors <<utility>>
    class Cors <<utility>>
  }

  package "util" {
    class LocalDate <<utility>>
    interface Clock
    class SystemClock
    interface IdGenerator
    class CryptoIdGenerator
  }
}

package "@gym/exercise-core" {
  abstract class Exercise {
    + id: string
    + displayName: string
    + xpRule: XpRule
    + summaryContribution: SummaryContribution
  }
  interface XpRule
  interface SummaryContribution
  class ExerciseRegistry
}

package "@gym/exercise-pushup" {
  class PushupExercise
  class PushupXpRule
  class PushupSummaryContribution
  class DefaultExerciseRegistryFactory <<utility>>
}

GetProgressHandler --> ProgressService
GetProgressHandler --> JwtVerifier
SetTimeZoneHandler --> ProgressService
SetTimeZoneHandler --> JwtVerifier
SetDailyTargetHandler --> ProgressService
SetDailyTargetHandler --> JwtVerifier
WorkoutLoggedConsumer --> ProgressService

ProgressService --> ProgressRepository
ProgressService --> ProcessedEventRepository
ProgressService --> EventPublisher
ProgressService --> ExerciseRegistry
ProgressService --> XpRules
ProgressService --> StreakRules
ProgressService --> FreezeRules
ProgressService --> LocalDate

ExerciseRegistry --> Exercise
PushupExercise --|> Exercise
PushupXpRule ..|> XpRule
PushupSummaryContribution ..|> SummaryContribution
DefaultExerciseRegistryFactory --> ExerciseRegistry
DefaultExerciseRegistryFactory --> PushupExercise

DynamoProgressRepository ..|> ProgressRepository
DynamoProcessedEventRepository ..|> ProcessedEventRepository
EventBridgeEventPublisher ..|> EventPublisher
JwksJwtVerifier ..|> JwtVerifier
SystemClock ..|> Clock
CryptoIdGenerator ..|> IdGenerator

@enduml
