@startuml
title Gym pushup-counter: core classes (Stage 2 + strict detector)

skinparam shadowing false

package "@gym/pose" {
  interface PoseLandmark
  enum PoseLandmarkIndex {
    LeftShoulder
    RightShoulder
    LeftElbow
    RightElbow
    LeftWrist
    RightWrist
    LeftHip
    RightHip
    LeftKnee
    RightKnee
    LeftAnkle
    RightAnkle
  }

  class PoseGeometry <<utility>> {
    + {static} jointAngleDegrees(a, b, c): number
  }

  interface PoseSource {
    + start(listener): Promise<void>
    + stop(): Promise<void>
  }

  interface RepDetector {
    + processFrame(landmarks): RepObservation
    + reset(): void
  }

  class RepCounter {
    - count: number
    + processFrame(landmarks): boolean
    + getCount(): number
    + getLastObservation(): RepObservation | null
    + reset(): void
  }

  class MediaPipePoseSource <<browser>>

  class SkeletonRenderer <<browser>> {
    + render(context, landmarks, size, options): void
    + clear(context, size): void
  }
}

package "@gym/exercise-pushup" {
  class PushupRepDetector
  class StrictPushupRepDetector {
    - viewDetector: ViewDetector
    - frontStrategy: PushupRepStrategy
    - sideStrategy: PushupRepStrategy
    - postureHold: PostureHoldTolerance
    + processFrame(landmarks): RepObservation
    + reset(): void
  }
  interface PushupRepStrategy {
    + processFrame(landmarks, nowMs): PushupRepStrategyResult
    + reset(): void
  }
  class FrontShoulderSignalStrategy {
    + processFrame(landmarks, nowMs): PushupRepStrategyResult
    + reset(): void
  }
  class SideArmElbowStrategy {
    + processFrame(landmarks, nowMs): PushupRepStrategyResult
    + reset(): void
  }
  class PostureHoldTolerance {
    + observeOk(): void
    + observeMiss(nowMs): boolean
    + reset(): void
  }
  interface PushupPositionGate {
    + evaluate(landmarks): PushupPositionEvaluation
  }
  interface DescentStrategy {
    + reset(): void
    + markUp(landmarks): void
    + observe(landmarks): void
    + isDescentSufficient(): boolean
  }
  class ViewDetector {
    + observe(landmarks): PushupViewKind
    + getView(): PushupViewKind
    + reset(): void
  }
  class CompositePushupPositionGate {
    + evaluate(landmarks): PushupPositionEvaluation
  }
  class CompositeDescentStrategy {
    + reset(): void
    + markUp(landmarks): void
    + observe(landmarks): void
    + isDescentSufficient(): boolean
  }
  class DropoutTolerance {
    + observeOk(): void
    + observeMiss(): boolean
    + reset(): void
  }
  class PostureGate {
    + evaluate(landmarks): PushupPositionEvaluation
  }
  class FrontPostureGate {
    + evaluate(landmarks): PushupPositionEvaluation
  }
  class ElbowAngleStrategy {
    + evaluate(landmarks): ElbowReading | null
  }
  class ShoulderDropStrategy {
    + markUp(landmarks): void
    + observe(landmarks): void
    + isDescentSufficient(): boolean
    + reset(): void
  }
  class FrontDescentStrategy {
    + markUp(landmarks): void
    + observe(landmarks): void
    + isDescentSufficient(): boolean
    + reset(): void
  }
  class RepTimingGate {
    + markDown(nowMs): void
    + isDurationValid(nowMs): boolean
    + reset(): void
  }
  class AngleSmoother {
    + push(value): number
    + value(): number | null
    + reset(): void
  }
  class PushupExercise
  class PushupXpRule
  class PushupSummaryContribution
  class DefaultExerciseRegistryFactory <<utility>>
}

package "apps/pushup-counter/src" {
  class PushupRepCounter <<facade>> {
    + processFrame(landmarks): boolean
    + getCount(): number
    + getPhase(): PushupPhase
    + getLastElbowAngle(): number | null
    + reset(): void
  }

  class PushupCounter <<React>> {
    + onComplete(count): void
    + createSource?(video): PoseSource
  }
}

package "apps/web/src/counters" {
  class PushupExerciseCounter <<React>> {
    + render(): JSX.Element
  }
}

RepCounter --> RepDetector
PushupRepDetector ..|> RepDetector
PushupRepDetector ..> PoseGeometry
PushupRepDetector ..> PoseLandmarkIndex
StrictPushupRepDetector ..|> RepDetector
StrictPushupRepDetector --> ViewDetector
StrictPushupRepDetector --> PushupRepStrategy
StrictPushupRepDetector --> PostureHoldTolerance
FrontShoulderSignalStrategy ..|> PushupRepStrategy
SideArmElbowStrategy ..|> PushupRepStrategy
FrontShoulderSignalStrategy --> AngleSmoother
FrontShoulderSignalStrategy --> RepTimingGate
SideArmElbowStrategy --> AngleSmoother
SideArmElbowStrategy --> RepTimingGate
SideArmElbowStrategy ..> PoseGeometry
PostureGate ..|> PushupPositionGate
FrontPostureGate ..|> PushupPositionGate
ShoulderDropStrategy ..|> DescentStrategy
FrontDescentStrategy ..|> DescentStrategy
CompositePushupPositionGate ..|> PushupPositionGate
CompositePushupPositionGate --> ViewDetector
CompositePushupPositionGate --> PostureGate
CompositePushupPositionGate --> FrontPostureGate
CompositeDescentStrategy ..|> DescentStrategy
CompositeDescentStrategy --> ViewDetector
CompositeDescentStrategy --> ShoulderDropStrategy
CompositeDescentStrategy --> FrontDescentStrategy
PostureGate ..> PoseGeometry
FrontPostureGate ..> PoseLandmarkIndex
FrontDescentStrategy ..> PoseLandmarkIndex
ViewDetector ..> PoseLandmarkIndex
ElbowAngleStrategy ..> PoseGeometry
PushupRepCounter --> RepCounter
PushupRepCounter --> PushupRepDetector
MediaPipePoseSource ..|> PoseSource
PushupCounter --> PoseSource
PushupCounter --> RepCounter
PushupCounter --> PushupRepDetector
PushupCounter ..> MediaPipePoseSource
PushupExerciseCounter --> RepCounter
PushupExerciseCounter --> StrictPushupRepDetector
PushupExerciseCounter --> SkeletonRenderer
PushupExerciseCounter ..> MediaPipePoseSource

@enduml
