@startuml
title Gym pushup-counter: core classes (Stage 2)

skinparam shadowing false

package "@gym/pose" {
  interface PoseLandmark
  enum PoseLandmarkIndex {
    LeftShoulder
    RightShoulder
    LeftElbow
    RightElbow
    LeftWrist
    RightWrist
    LeftHip
    RightHip
    LeftKnee
    RightKnee
    LeftAnkle
    RightAnkle
  }

  class PoseGeometry <<utility>> {
    + {static} jointAngleDegrees(a, b, c): number
  }

  interface PoseSource {
    + start(listener): Promise<void>
    + stop(): Promise<void>
  }

  interface RepDetector {
    + processFrame(landmarks): RepObservation
    + reset(): void
  }

  class RepCounter {
    - count: number
    + processFrame(landmarks): boolean
    + getCount(): number
    + getLastObservation(): RepObservation | null
    + reset(): void
  }

  class MediaPipePoseSource <<browser>>
}

package "@gym/exercise-pushup" {
  class PushupRepDetector
  class PushupExercise
  class PushupXpRule
  class PushupSummaryContribution
  class DefaultExerciseRegistryFactory <<utility>>
}

package "apps/pushup-counter/src" {
  class PushupRepCounter <<facade>> {
    + processFrame(landmarks): boolean
    + getCount(): number
    + getPhase(): PushupPhase
    + getLastElbowAngle(): number | null
    + reset(): void
  }

  class PushupCounter <<React>> {
    + onComplete(count): void
    + createSource?(video): PoseSource
  }
}

RepCounter --> RepDetector
PushupRepDetector ..|> RepDetector
PushupRepDetector ..> PoseGeometry
PushupRepDetector ..> PoseLandmarkIndex
PushupRepCounter --> RepCounter
PushupRepCounter --> PushupRepDetector
MediaPipePoseSource ..|> PoseSource
PushupCounter --> PoseSource
PushupCounter --> RepCounter
PushupCounter --> PushupRepDetector
PushupCounter ..> MediaPipePoseSource

@enduml
