@startuml catalogue-get-exercises
title Gym catalogue: GET /exercises happy path

actor Client
participant "CatalogueWorker" as Worker
participant "Router" as Router
participant "ExerciseHandlers" as Handlers
participant "ListParamsParser" as Parser
participant "D1ExerciseRepository" as Repo
participant "ExerciseFormatter" as Fmt
database "D1" as DB

Client -> Worker : GET /exercises?muscle=chest
Worker -> Router : route(request)
Router -> Handlers : handleList(request)
Handlers -> Parser : parse(url)
Parser --> Handlers : ListParams
Handlers -> Repo : listExercises(params)
Repo -> DB : SELECT ... WHERE muscles LIKE ? ORDER BY name LIMIT ? OFFSET ?
DB --> Repo : rows
Repo -> Fmt : fromRow(row) per row
Fmt --> Repo : Exercise[]
Repo --> Handlers : Exercise[]
Handlers -> Repo : countExercises(params)
Repo -> DB : SELECT COUNT(*) WHERE muscles LIKE ?
DB --> Repo : total
Repo --> Handlers : total
Handlers --> Router : Response(200, ExerciseListResponse)
Router --> Worker : Response
Worker --> Client : 200 application/json

@enduml
