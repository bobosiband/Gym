@startuml catalogue-get-exercises
title Gym catalogue: GET /exercises happy path

actor Client
participant "CatalogueWorker" as Worker
participant "Router" as Router
participant "Cors" as Cors
participant "ExerciseHandlers" as Handlers
participant "ListParamsParser" as Parser
participant "D1ExerciseRepository" as Repo
participant "ExerciseFormatter" as Fmt
participant "JsonResponder" as Json
database "D1" as DB

Client -> Worker : GET /exercises?muscle=chest\nOrigin: http://localhost:5173
Worker -> Router : route(request)
Router -> Router : dispatch(request, "GET")
Router -> Handlers : handleList(request)
Handlers -> Parser : parse(url)
Parser --> Handlers : ListParams
Handlers -> Repo : listExercises(params)
Repo -> DB : SELECT ... WHERE muscles LIKE ?\n  ORDER BY name LIMIT ? OFFSET ?
DB --> Repo : rows
Repo -> Fmt : fromRow(row) per row
Fmt --> Repo : Exercise[] (with licence, author, sourceUrl)
Repo --> Handlers : Exercise[]
Handlers -> Repo : countExercises(params)
Repo -> DB : SELECT COUNT(*) WHERE muscles LIKE ?
DB --> Repo : total
Repo --> Handlers : total
Handlers -> Json : respondCached(200, body, 300)
Json --> Handlers : Response\n(cache-control: public, max-age=300)
Handlers --> Router : Response
Router -> Cors : withCorsHeaders(response, request, origins)
Cors --> Router : Response\n(+ access-control-allow-origin,\n   vary: Origin)
Router --> Worker : Response
Worker --> Client : 200 application/json

@enduml
