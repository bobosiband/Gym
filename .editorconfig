root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,md,html,css,scss}]
indent_size = 2

[*.py]
indent_size = 4

[*.java]
indent_size = 2

[*.{xml,puml}]
indent_size = 2

[Makefile]
indent_style = tab
