{
  "name": "@gym/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gym PWA shell. React + TypeScript + Vite. Installable, offline-capable.",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "@gym/contracts": "workspace:*",
    "@gym/exercise-pushup": "workspace:*",
    "@gym/pose": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
