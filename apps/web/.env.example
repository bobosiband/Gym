# Local developer environment for apps/web. Copy to apps/web/.env and
# fill in. Never commit apps/web/.env; it is gitignored.
#
# Vite inlines any variable prefixed with VITE_ into the client bundle
# at build time, so only non-secret URLs and public identifiers belong
# here. Never put private keys, SMTP credentials, or AWS access keys
# in this file.

# Auth service (AWS Lambda + HTTP API).
VITE_AUTH_API_URL=
VITE_AUTH_JWKS_URL=
VITE_JWT_ISSUER=
VITE_JWT_AUDIENCE=gym-api

# Catalogue service (Cloudflare Worker + D1).
VITE_CATALOGUE_API_URL=

# Later services, not deployed yet. Uncomment and fill in as each one
# lands so the frontend never has to redeploy to pick up new URLs.
# VITE_LOGGING_API_URL=
# VITE_MEDIA_BASE_URL=
# VITE_PROGRESS_API_URL=
# VITE_ACHIEVEMENTS_API_URL=
# VITE_PLANNER_API_URL=
# VITE_STATS_API_URL=
# VITE_REMINDERS_API_URL=
