{
  "name": "gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Gym: a free, gamified fitness web app, built as a microservice monorepo.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm run lint:ts && pnpm run lint:fmt && pnpm run style:check",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:fmt": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "style:check": "node scripts/style-check.mjs",
    "uml:check": "node scripts/uml-check.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
